{
  "name": "ISP-QA-Automation",
  "version": "1.0.0",
  "description": "AI powered QA Automation for ISP",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:bdd": "cucumber-js",
    "test:chrome": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "allure:generate": "npx allure-commandline generate allure-results --clean -o allure-report",
    "allure:open": "npx allure-commandline open allure-report",
    "test:allure": "npm run test:teacher1 && npm run allure:generate && npm run allure:open",
    "report": "allure serve allure-results",
    "cucumberautocomplete.steps": "step-definitions/**/*.js",
    "cucumberautocomplete.syncfeatures": "true",
    "cucumberautocomplete.strictGherkinCompletion": "true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.2",
    "allure-playwright": "^3.10.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "xlsx": "^0.18.5"
  }
}